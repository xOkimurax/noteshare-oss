# Environment for running the API directly (npm run dev -w @noteshare/api).
# Copy to apps/api/.env. Docker users: use the root .env.example instead.
NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://noteshare:change-me@localhost:5432/noteshare

WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

UPLOADS_DIR=./uploads
ADMIN_EMAILS=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Noteshare
