# ───────────────────────────────────────────────────────────────
# Noteshare — root environment file used by docker-compose.yml
# Copy to `.env` and fill in the values:   cp .env.example .env
# ───────────────────────────────────────────────────────────────

# ── Public URLs (REQUIRED) ─────────────────────────────────────
# Origin of the web app and of the API. For cookie auth to work in production
# both must be on the SAME registrable domain (e.g. app.example.com and
# api.example.com) and served over HTTPS.
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# ── Database (REQUIRED) ────────────────────────────────────────
POSTGRES_USER=noteshare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=noteshare

# ── Session secrets (REQUIRED) ─────────────────────────────────
# Generate each one with:  openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Google sign-in (REQUIRED to log in) ────────────────────────
# Create an OAuth 2.0 "Web application" client at
# https://console.cloud.google.com/apis/credentials and add this exact
# redirect URI:  <API_PUBLIC_URL>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ── Optional ───────────────────────────────────────────────────
# Comma-separated emails with admin (read/write everything) access.
ADMIN_EMAILS=

# Transactional email through Brevo (https://www.brevo.com). Leave empty to
# disable: emails are then printed to the API log instead of being sent.
# The sender must be verified in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Noteshare
